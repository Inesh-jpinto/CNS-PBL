<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- ── Project identity ─────────────────────────────────────────────────── -->
  <groupId>com.modelguard</groupId>
  <artifactId>modelguard-crypto</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>ModelGuard Crypto Service</name>
  <description>
    Cryptographic integrity and provenance verification for AI models.
    Implements SHA-256 layer hashing, Merkle Tree construction, RSA-2048
    digital signatures, and ElGamal signatures for academic demonstration.
    Course: Cryptography &amp; Network Security (22CSE71) — PBL Project.
  </description>

  <!-- ── Compiler settings ────────────────────────────────────────────────── -->
  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Source layout — all classes live in the flat modelguard package
         (not in com/modelguard/ subfolders) matching existing structure.   -->
    <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
    <testSourceDirectory>${project.basedir}/src/test/java</testSourceDirectory>
  </properties>

  <!-- ── Dependencies ─────────────────────────────────────────────────────── -->
  <dependencies>

    <!-- JSON-simple: used by ModelPublisher and ModelVerifier for manifest I/O.
         Jar is already vendored in crypto-java/lib/; this entry is for IDE
         support and Maven resolution fallback.                               -->
    <dependency>
      <groupId>com.googlecode.json-simple</groupId>
      <artifactId>json-simple</artifactId>
      <version>1.1.1</version>
    </dependency>

    <!-- JUnit 5: standard test framework (optional — tests can also be run
         as plain Java mains via 'test-all' mode in Main.java).               -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.0</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <!-- ── Build configuration ──────────────────────────────────────────────── -->
  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <testSourceDirectory>src/test/java</testSourceDirectory>

    <plugins>

      <!-- Shade plugin: produces a fat JAR with all dependencies included,
           so the Python backend can invoke it without a complex classpath.   -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <finalName>modelguard-crypto-${project.version}-all</finalName>
              <archive>
                <manifest>
                  <mainClass>modelguard.Main</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Surefire: run JUnit 5 tests with Maven test -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.1.2</version>
        <configuration>
          <!-- Also run our plain-Java test mains as integration tests -->
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>

      <!-- Compiler plugin: explicit Java 17 settings -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>

    </plugins>
  </build>

  <!-- ── Repositories ─────────────────────────────────────────────────────── -->
  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
  </repositories>

</project>
